# DataPulse — backend environment variables
# Copy this file to `.env` and fill in the values.

# DeepSeek API key. Get yours at https://platform.deepseek.com/
# Leave empty to run the AI chat in beta mode (the backend will return HTTP 503
# and the frontend will show a "key not configured" banner).
DEEPSEEK_API_KEY=

# DeepSeek model to use for the analysis chat. `deepseek-chat` is the default
# general-purpose model; `deepseek-reasoner` is available for deeper reasoning.
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek OpenAI-compatible API endpoint. Override only if you proxy through
# another service.
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Request timeout in seconds for the DeepSeek API call.
DEEPSEEK_TIMEOUT=60
